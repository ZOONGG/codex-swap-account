<Window x:Class="CodexProfileOverlay.SupportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Support Codex Swap Account"
        Width="700" Height="760" MinWidth="580" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource StrongTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="28">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Margin="2,0" CornerRadius="2" Background="{DynamicResource BorderBrush}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SupportOutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="1" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PressedSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SupportPrimaryButton" TargetType="Button" BasedOn="{StaticResource SupportOutlineButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="MinWidth" Value="128"/>
        </Style>

        <Style x:Key="SupportAmountInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputSurface" Margin="1" CornerRadius="10"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SupportCloseButton" TargetType="Button" BasedOn="{StaticResource SupportOutlineButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="SupportAmountSelector" TargetType="RadioButton">
            <Setter Property="Height" Value="50"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="1" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="16" Padding="24" SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="13"
                            Background="{DynamicResource TabActiveBrush}"
                            HorizontalAlignment="Left" SnapsToDevicePixels="True">
                        <Viewbox Width="22" Height="22">
                            <Path Fill="{DynamicResource ErrorBrush}"
                                  Data="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"/>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SupportTitle" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SupportSubtitle" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource SupportCloseButton}"
                            Click="CloseButton_Click" automation:AutomationProperties.Name="Close support">
                        <Canvas Width="16" Height="16" SnapsToDevicePixels="True">
                            <Path Data="M4,4 L12,12 M12,4 L4,12"
                                  Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Button>
                </Grid>

                <ScrollViewer x:Name="BodyScroll" Grid.Row="2" MaxHeight="440" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid Margin="2" MinHeight="240">
                        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="190" Height="4" IsIndeterminate="True"/>
                            <TextBlock x:Name="LoadingText" Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,14,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Grid x:Name="MethodsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="IntroText" Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"/>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TelegramMethodButton" Height="98" Padding="16"
                                        Style="{StaticResource SupportOutlineButton}"
                                        HorizontalContentAlignment="Stretch"
                                        Click="TelegramMethodButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{DynamicResource TabActiveBrush}">
                                            <Viewbox Width="25" Height="25"><Path Fill="#F5B82E" Data="M33.9367985,56.083055 L21.7503342,63.3925338 C19.8505861,64.5320086 17.3868093,63.9156853 16.2473345,62.0159372 C15.7137164,61.1262817 15.5455436,60.0644802 15.7781259,59.0534705 L18.9640288,45.2047011 C19.2960447,43.7614644 18.8058198,42.2527074 17.6889001,41.2802585 L6.97134809,31.9489955 C5.30058877,30.4943448 5.12539813,27.9606993 6.58004885,26.28994 C7.26126443,25.5075204 8.21912942,25.0194638 9.25252868,24.9282435 L23.4079892,23.6787121 C24.8831874,23.5484934 26.1666127,22.6160303 26.7463194,21.2532733 L32.3089723,8.1767567 C33.1761343,6.13825837 35.5316374,5.18870268 37.5701357,6.0558647 C38.5247682,6.46195826 39.2849342,7.22212421 39.6910277,8.1767567 L45.2536806,21.2532733 C45.8333873,22.6160303 47.1168126,23.5484934 48.5920108,23.6787121 L62.7474713,24.9282435 C64.9541662,25.123033 66.5851379,27.0698207 66.3903484,29.2765156 C66.2991281,30.3099149 65.8110716,31.2677799 65.0286519,31.9489955 L54.3110999,41.2802585 C53.1941802,42.2527074 52.7039553,43.7614644 53.0359712,45.2047011 L56.2218741,59.0534705 C56.7185246,61.2123553 55.3710173,63.365092 53.2121325,63.8617425 C52.2011228,64.0943248 51.1393213,63.9261519 50.2496658,63.3925338 L38.0632015,56.083055 C36.7932005,55.3213045 35.2067995,55.3213045 33.9367985,56.083055 Z"/></Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TelegramMethodTitle" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock x:Name="TelegramMethodHint" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button x:Name="CryptoMethodButton" Grid.Column="2" Height="98" Padding="16"
                                        Style="{StaticResource SupportOutlineButton}"
                                        HorizontalContentAlignment="Stretch"
                                        Click="CryptoMethodButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="20"
                                                Background="{DynamicResource TabActiveBrush}">
                                            <Image Source="Assets/Support/btc.png" Width="32" Height="32"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="CryptoMethodTitle" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock x:Name="CryptoMethodHint" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Grid>

                        <Grid x:Name="AmountPanel" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ChooseAmountTitle" FontSize="18" FontWeight="SemiBold"/>
                                <WrapPanel x:Name="PresetPanel" Margin="0,18,0,8"/>
                                <TextBlock x:Name="CustomAmountLabel" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <Grid Margin="0,8,0,0">
                                    <TextBox x:Name="CustomAmountTextBox" Height="50" Padding="14,10,48,10" Style="{StaticResource SupportAmountInput}"
                                             TextChanged="CustomAmountTextBox_TextChanged"
                                             LostKeyboardFocus="CustomAmountTextBox_LostKeyboardFocus"
                                             KeyDown="CustomAmountTextBox_KeyDown"/>
                                    <ContentControl x:Name="AmountSuffixText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,16,0" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" IsHitTestVisible="False"/>
                                </Grid>
                                <TextBlock x:Name="AmountValidationText" Foreground="{DynamicResource ErrorBrush}"
                                           FontSize="12" MinHeight="18" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <CheckBox x:Name="TermsCheckBox" Margin="0,12,0,0"
                                          Checked="TermsCheckBox_Changed" Unchecked="TermsCheckBox_Changed">
                                    <TextBlock x:Name="TermsText" TextWrapping="Wrap"/>
                                </CheckBox>
                                <TextBlock x:Name="TermsHint" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" Margin="32,6,0,0" TextWrapping="Wrap"/>
                                <Grid Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BackToMethodsButton" Grid.Column="1" Style="{StaticResource SupportOutlineButton}"
                                            Click="BackToMethodsButton_Click"/>
                                    <Button x:Name="ContinueButton" Grid.Column="3" Style="{StaticResource SupportPrimaryButton}"
                                            IsDefault="True" IsEnabled="False" Click="ContinueButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="AssetPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ChooseAssetTitle" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ChooseAssetHint" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Grid x:Name="AssetButtons" Grid.Row="2"/>
                            <Button x:Name="BackToAmountButton" Grid.Row="4" HorizontalAlignment="Left"
                                    Style="{StaticResource SupportOutlineButton}" Click="BackToAmountButton_Click"/>
                        </Grid>

                        <Grid x:Name="CheckoutPanel" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="CheckoutMethodText" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CheckoutAmountText" FontSize="27" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <ContentControl x:Name="CheckoutAmountSuffix" FontSize="22" Margin="7,2,0,0"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                                <Border x:Name="QrFrame" Width="248" Height="248" Margin="0,16,0,0"
                                        Background="White" CornerRadius="16" Padding="14"
                                        SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <Image x:Name="QrImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           automation:AutomationProperties.Name="Payment checkout QR code"/>
                                </Border>
                                <TextBlock x:Name="ScanText" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,11,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                                <Button x:Name="OpenTelegramButton" Width="280" Margin="0,18,0,0"
                                        Style="{StaticResource SupportPrimaryButton}"
                                        Click="OpenTelegramButton_Click"/>
                                <StackPanel x:Name="CryptoDetailsPanel" Visibility="Collapsed" Width="470" Margin="0,14,0,0">
                                    <Border Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="12" Padding="14,9" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="AddressLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                                                <TextBlock x:Name="AddressText" FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,10,0"/>
                                            </StackPanel>
                                            <Button x:Name="CopyAddressButton" Grid.Column="1" Width="38" Height="38"
                                                    Style="{StaticResource SupportOutlineButton}" Padding="0"
                                                    Click="CopyAddressButton_Click">
                                                <Viewbox Width="16" Height="16">
                                                    <Path Data="M8,8 H19 V19 H8 Z M5,5 H16 V8 M5,5 V16 H8"
                                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"
                                                          Fill="Transparent" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="NetworkWarningText" Foreground="{DynamicResource ErrorBrush}"
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="6,8,6,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
                                        <TextBlock x:Name="WaitingText" Foreground="{DynamicResource MutedTextBrush}" FontSize="13"/>
                                    </StackPanel>
                                    <ProgressBar Width="220" Height="3" Margin="0,9,0,0" IsIndeterminate="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" MaxWidth="440">
                            <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource TabActiveBrush}"
                                    SnapsToDevicePixels="True">
                                <Viewbox Width="34" Height="34">
                                    <Path Fill="{DynamicResource ErrorBrush}"
                                          Data="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"/>
                                </Viewbox>
                            </Border>
                            <TextBlock x:Name="ThankYouTitle" FontSize="25" FontWeight="SemiBold"
                                       Margin="0,24,0,0" TextAlignment="Center"/>
                            <Border Margin="0,16,0,0" Padding="14,7" Background="{DynamicResource TabActiveBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="18"
                                    HorizontalAlignment="Center" SnapsToDevicePixels="True">
                                <TextBlock x:Name="ThankYouAmountText" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock x:Name="ThankYouText" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="14" LineHeight="22" Margin="0,20,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="DoneButton" Width="160" Margin="0,28,0,0"
                                    Style="{StaticResource SupportPrimaryButton}" IsDefault="True"
                                    Click="CloseButton_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="TerminalPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" MaxWidth="470">
                            <Border Width="58" Height="58" CornerRadius="29" Background="{DynamicResource TabActiveBrush}"
                                    SnapsToDevicePixels="True">
                                <TextBlock Text="!" FontSize="27" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TerminalTitle" FontSize="20" FontWeight="SemiBold"
                                       Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TerminalText" Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="CreateNewButton" Margin="0,22,0,0"
                                    Style="{StaticResource SupportPrimaryButton}" Click="CreateNewButton_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="CopyToast" Panel.ZIndex="20" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,8"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <TextBlock x:Name="CopyToastText" FontSize="12" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
