<Project>
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>1.1.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Codex Swap Account</Product>
    <CodexSwapSupportApiBaseUrl Condition="'$(CodexSwapSupportApiBaseUrl)' == '' and '$(Configuration)' == 'Release'">https://support-backend-production-8891.up.railway.app</CodexSwapSupportApiBaseUrl>
  </PropertyGroup>
</Project>
