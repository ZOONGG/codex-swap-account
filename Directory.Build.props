<Project>
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Codex Swap Account</Product>
    <CodexSwapSupportApiBaseUrl Condition="'$(CodexSwapSupportApiBaseUrl)' == '' and '$(Configuration)' == 'Release'">https://support-backend-production-8891.up.railway.app</CodexSwapSupportApiBaseUrl>
  </PropertyGroup>
</Project>
