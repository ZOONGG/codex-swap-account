<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CodexProfileOverlay.Core\CodexProfileOverlay.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the actual Windows adapters into tests without a WPF/runtime dependency. -->
    <Compile Include="..\..\src\CodexProfileOverlay\WindowsDesktopProcessCatalog.cs" Link="WindowsAdapters\WindowsDesktopProcessCatalog.cs" />
    <Compile Include="..\..\src\CodexProfileOverlay\WindowsTrayRegistration.cs" Link="WindowsAdapters\WindowsTrayRegistration.cs" />
    <Compile Include="..\..\src\CodexProfileOverlay\CodexAppLauncher.cs" Link="WindowsAdapters\CodexAppLauncher.cs" />
  </ItemGroup>
</Project>
